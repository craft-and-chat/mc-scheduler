# Reference of every setting. Nothing here is read directly from this file —
# copy values to the right place (see docs/SETUP.md):
#   worker/wrangler.jsonc "vars"   → non-secret worker settings (committed)
#   wrangler secret put <NAME>     → worker secrets (never committed); locally: worker/.dev.vars
#   GitHub repo variable API_URL   → web app build (or web/.env.local for local dev)

# ---------- Worker secrets (wrangler secret put NAME) ----------
DISCORD_WEBHOOK_URL=        # Discord channel → Edit → Integrations → Webhooks → Copy URL
ADMIN_KEY=                  # any long random string; unlocks the #admin page
ACCESS_CODE=                # optional: if set, the app only works via links containing ?code=<this>
DISCORD_BOT_TOKEN=          # optional: lets the app create Discord "Events" for each session
DISCORD_GUILD_ID=           # optional: your Discord server id (needed with the bot token)

# ---------- Worker vars (worker/wrangler.jsonc) ----------
APP_NAME=Craft & Chat
APP_URL=https://<github-user>.github.io/mc-scheduler/
ALLOWED_ORIGINS=https://<github-user>.github.io
MC_SERVER_ADDRESS=          # empty = "Server address coming soon"
DISCORD_INVITE_URL=         # empty = placeholder
DISCORD_MENTION=            # e.g. @everyone, @here, <@&ROLE_ID>, or empty for no ping
TIMEZONE=Europe/London
DAY_START_HOUR=12           # first bookable hour
DAY_END_HOUR=24             # last bookable hour (exclusive), up to 30 = 06:00
SESSION_HOURS=2
MIN_PLAYERS=2
OPEN_DAYS_BEFORE=3          # "availability open" post: Fri…
OPEN_HOUR=12                # …12:00
REMINDER_DAYS_BEFORE=2      # reminder: Sat…
REMINDER_HOUR=18            # …18:00
LOCK_DAYS_BEFORE=1          # decision + announcement: Sun…
LOCK_HOUR=18                # …18:00
SESSION_REMINDER_MINUTES=60

# ---------- Web app build ----------
VITE_API_URL=https://mc-scheduler.<your-subdomain>.workers.dev
